# Copy to .env.local and fill in real values there. Never commit .env.local.

# Contact form email (https://resend.com). The form stays switched off until both of these are set.
RESEND_API_KEY=re_your_key_here
ENQUIRY_TO=enquiries@example.com
# Optional. Needs a domain verified in Resend. Leave empty to use Resend's test sender.
# ENQUIRY_FROM=Build Right website <hello@example.com>
